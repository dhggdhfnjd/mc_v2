{
  "name": "mizani-api",
  "version": "0.1.0",
  "private": true,
  "description": "Account API for Mizani: Cloudflare Worker over a D1 (SQLite) users table.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute mizani --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute mizani --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit",
    "start": "bun run server.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250204.0",
    "typescript": "^5",
    "wrangler": "^3.90.0"
  }
}
